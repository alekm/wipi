#!/bin/bash
# WiPi Initial Setup Script
# Generates credentials and creates .env for controller and agent deployment.
# Run once after cloning; .env is used by docker-compose and deploy scripts.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_ROOT/.env"

cd "$PROJECT_ROOT"

echo -e "${CYAN}"
echo "=============================================="
echo "  WiPi Initial Setup"
echo "=============================================="
echo -e "${NC}"
echo "This script will:"
echo "  1. Generate a secure AGENT_API_KEY"
echo "  2. Set admin password (for UI login)"
echo "  3. Optionally generate encryption key (for secrets at rest)"
echo "  4. Configure controller URL (for agent deployment)"
echo "  5. Create .env file (used by docker-compose and deploy scripts)"
echo ""

# Check if .env already exists
if [ -f "$ENV_FILE" ]; then
    echo -e "${YELLOW}.env already exists.${NC}"
    echo ""
    echo "Options:"
    echo "  1) Regenerate credentials (overwrites AGENT_API_KEY, passwords, etc.)"
    echo "  2) Keep existing .env and exit"
    echo "  3) Update CONTROLLER_URL only (keep other values)"
    echo ""
    read -p "Choice [1/2/3]: " choice
    case "$choice" in
        2) echo "Exiting. No changes made."; exit 0 ;;
        3) UPDATE_CONTROLLER_ONLY=1 ;;
        *) ;;
    esac
fi

# Generate AGENT_API_KEY (unless updating URL only)
if [ -z "$UPDATE_CONTROLLER_ONLY" ]; then
    AGENT_API_KEY=$(openssl rand -hex 32)
    echo -e "${GREEN}✓ Generated AGENT_API_KEY${NC}"
fi

# Admin password
if [ -z "$UPDATE_CONTROLLER_ONLY" ]; then
    echo ""
    echo "Admin password for UI login (Demo -> Admin switch):"
    echo "  - Must be at least 8 characters"
    echo "  - Leave blank to use default 'Ruckus123!' (not recommended)"
    echo ""
    read -sp "Enter admin password: " ADMIN_PASSWORD
    echo ""
    if [ -z "$ADMIN_PASSWORD" ]; then
        ADMIN_PASSWORD="Ruckus123!"
        echo -e "${YELLOW}Using default password 'Ruckus123!'${NC}"
    fi
    WIPI_ADMIN_PASSWORD_HASH=$(echo -n "$ADMIN_PASSWORD" | sha256sum | awk '{print $1}')
    echo -e "${GREEN}✓ Admin password hash generated${NC}"
fi

# Optional: WIPI_ENCRYPTION_KEY
if [ -z "$UPDATE_CONTROLLER_ONLY" ]; then
    echo ""
    read -p "Generate encryption key for secrets at rest? (Ruckus One creds, PSK passphrases) [Y/n]: " gen_enc
    if [[ ! "$gen_enc" =~ ^[Nn] ]]; then
        WIPI_ENCRYPTION_KEY=$(python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())' 2>/dev/null || echo "")
        if [ -n "$WIPI_ENCRYPTION_KEY" ]; then
            echo -e "${GREEN}✓ Generated WIPI_ENCRYPTION_KEY${NC}"
        else
            echo -e "${YELLOW}⚠ Python cryptography not installed. Run: pip install cryptography${NC}"
            echo "  Skipping encryption key. Secrets will be stored in plaintext."
            WIPI_ENCRYPTION_KEY=""
        fi
    else
        WIPI_ENCRYPTION_KEY=""
    fi
fi

# Controller URL
echo ""
echo "Controller URL (for agent deployment and docker-compose):"
echo "  - Use the IP/hostname where the controller will run"
echo "  - Agents must reach this URL from the network"
echo "  - Examples: http://192.168.1.50:8000  http://controller.local:8000"
echo ""

# Try to detect a reasonable default
DEFAULT_CONTROLLER=""
if command -v hostname &>/dev/null && command -v ip &>/dev/null; then
    # Prefer primary non-loopback IP
    LAN_IP=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K[\d.]+' || hostname -I 2>/dev/null | awk '{print $1}')
    if [ -n "$LAN_IP" ]; then
        DEFAULT_CONTROLLER="http://${LAN_IP}:8000"
    fi
fi
[ -z "$DEFAULT_CONTROLLER" ] && DEFAULT_CONTROLLER="http://localhost:8000"

if [ -n "$UPDATE_CONTROLLER_ONLY" ]; then
    CURRENT_URL=$(grep -E "^CONTROLLER_URL=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- || echo "")
    [ -n "$CURRENT_URL" ] && DEFAULT_CONTROLLER="$CURRENT_URL"
fi

read -p "Controller URL [$DEFAULT_CONTROLLER]: " CONTROLLER_URL
CONTROLLER_URL="${CONTROLLER_URL:-$DEFAULT_CONTROLLER}"
echo -e "${GREEN}✓ Controller URL: $CONTROLLER_URL${NC}"

# Preserve existing values if only updating controller
if [ -n "$UPDATE_CONTROLLER_ONLY" ] && [ -f "$ENV_FILE" ]; then
    AGENT_API_KEY=$(grep -E "^AGENT_API_KEY=" "$ENV_FILE" | cut -d= -f2- || echo "")
    WIPI_ADMIN_PASSWORD_HASH=$(grep -E "^WIPI_ADMIN_PASSWORD_HASH=" "$ENV_FILE" | cut -d= -f2- || echo "")
    WIPI_ENCRYPTION_KEY=$(grep -E "^WIPI_ENCRYPTION_KEY=" "$ENV_FILE" | cut -d= -f2- || echo "")
fi

# Create data directory
mkdir -p "$PROJECT_ROOT/data"
echo -e "${GREEN}✓ Data directory ready${NC}"

# Write .env
echo ""
echo "Writing .env..."

cat > "$ENV_FILE" <<ENVEOF
# WiPi Configuration - Generated by wipi-init
# Edit as needed. Used by docker-compose and deploy scripts.

# ============================================================================
# ADMIN AUTHENTICATION
# ============================================================================
WIPI_ADMIN_PASSWORD_HASH=${WIPI_ADMIN_PASSWORD_HASH}

# ============================================================================
# AGENT AUTHENTICATION
# ============================================================================
AGENT_API_KEY=${AGENT_API_KEY}

# ============================================================================
# ENCRYPTION (secrets at rest)
# ============================================================================
WIPI_ENCRYPTION_KEY=${WIPI_ENCRYPTION_KEY}

# ============================================================================
# CONTROLLER & DEPLOYMENT
# ============================================================================
# Controller URL - used by agents and deploy scripts
CONTROLLER_URL=${CONTROLLER_URL}

# ============================================================================
# CONTROLLER (Docker) - optional overrides
# ============================================================================
DATABASE_URL=sqlite:///./data/wipi.db
SCENARIO_DIR=/app/scenarios
TZ=America/New_York

# ============================================================================
# AGENT DEFAULTS (for deploy scripts) - optional overrides
# ============================================================================
# PI_USER=admin
# API_PORT=8080
# MAX_INTERFACES=8
# BASE_INTERFACE=wlan0
ENVEOF

chmod 600 "$ENV_FILE"
echo -e "${GREEN}✓ Created $ENV_FILE${NC}"

# Summary
echo ""
echo -e "${CYAN}=============================================="
echo "  Setup Complete"
echo "=============================================="
echo -e "${NC}"
echo "Next steps:"
echo ""
echo "  1. Start the controller and UI:"
echo -e "     ${GREEN}docker compose up -d --build${NC}"
echo ""
echo "  2. Deploy agents to Raspberry Pis:"
echo -e "     ${GREEN}./scripts/deploy-to-pi.sh <pi-ip> [hostname]${NC}"
echo "     (Deploy script will use AGENT_API_KEY and CONTROLLER_URL from .env)"
echo ""
echo "  3. Open the UI: http://localhost:8080"
echo "     Switch to Admin mode and enter your password to manage the simulation."
echo ""
echo -e "${YELLOW}Keep .env secure and do not commit it to version control.${NC}"
echo ""
