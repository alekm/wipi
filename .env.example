# WiPi Configuration Example
# 
# For initial setup, run: ./scripts/wipi-init
# That script generates credentials and creates .env for you.
#
# Or copy this file to .env and customize manually.

# ============================================================================
# ADMIN AUTHENTICATION
# ============================================================================

# Admin password hash for UI authentication (SHA-256)
# Default password: "Ruckus123!"
# Generate new hash: echo -n "YourPassword" | sha256sum
WIPI_ADMIN_PASSWORD_HASH=8f4179b458b4e4622c32089b025ff4e4b531137642dfdf5143b5f29af3c32e84

# ============================================================================
# AGENT AUTHENTICATION
# ============================================================================

# API key for agent-to-controller communication (256-bit hex)
# Generate new key: openssl rand -hex 32
AGENT_API_KEY=387d5f76c069bc167dc3ba74b1adb2b25233e9874e369dfa436894c3906bad0e

# ============================================================================
# CONTROLLER CONFIGURATION
# ============================================================================

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./data/wipi.db

# Scenario directory
SCENARIO_DIR=/app/scenarios

# Monitoring intervals (seconds)
POLL_INTERVAL_SECONDS=10
PI_TIMEOUT_SECONDS=30
MONITORING_POLL_TIMEOUT=5

# Orchestrator timeouts (seconds)
ORCHESTRATOR_CONFIGURE_TIMEOUT=10
ORCHESTRATOR_APPLY_TIMEOUT=120
ORCHESTRATOR_STOP_TIMEOUT=30
ORCHESTRATOR_STATUS_TIMEOUT=5

# Ruckus One integration timeout (seconds)
RUCKUS_ONE_API_TIMEOUT=10

# Timezone for logs (adjust for your location)
TZ=America/New_York

# CORS allowed origins (* = allow all, default for flexible deployment)
# CORS_ORIGINS=*

# Log format: empty = text, json = structured JSON for ELK/Datadog/etc
# LOG_FORMAT=json

# ============================================================================
# AGENT CONFIGURATION (for agents deployed to Raspberry Pis)
# ============================================================================

# Agent identification
AGENT_ID=wipi-01

# Controller URL (must be accessible from agent)
CONTROLLER_URL=http://192.168.1.50:8000

# Agent API port
API_PORT=8080

# Maximum interfaces per Pi
MAX_INTERFACES=8

# Base wireless interface
BASE_INTERFACE=wlan0

# DHCP client (dhclient or udhcpc)
DHCP_CLIENT=dhclient

# Mock mode for testing without hardware
MOCK_MODE=false

# Agent timeouts (seconds)
WPA_CONNECTION_TIMEOUT=30
WPA_PROCESS_TIMEOUT=5
DHCP_IP_TIMEOUT=30
DHCP_PROCESS_TIMEOUT=5
CAPTIVE_PORTAL_TIMEOUT=10
REGISTRATION_TIMEOUT=5
BULK_TRANSFER_TIMEOUT=300
YOUTUBE_TIMEOUT=30
SPEEDTEST_TIMEOUT=60
SPEEDTEST_PING_TIMEOUT=10
CONFIG_PULL_INTERVAL=30
